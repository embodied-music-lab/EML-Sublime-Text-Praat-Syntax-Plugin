<snippet>
    <content><![CDATA[# ============================================================================
# AVQI v.02.06 + v.03.01 Analysis Template
#
# Independent implementation of the Acoustic Voice Quality Index
# methodology. Computes BOTH version 2.06 (Maryn & Weenink, 2015) AND
# version 3.01 (Barsties & Maryn, 2015) scores from the same predictor
# set on the same concatenated avqi signal.
#
# The two versions differ only in regression coefficients (the same
# extraction procedure is used; v.03.01's "equalized duration" is
# achieved through input protocol — syllable-controlled CS — not
# through script-level transformation). See Barsties & Maryn (2015,
# Am J Otolaryngol 36:647-656, Section 2.2/2.6) and Fantini et al.
# (2021/2023, J Voice 37:631.e1-631.e6) for the v.03.01 specification.
#
# Free implementation. Published methodology, parameter values, and
# regression coefficients are used as facts. Code is original.
#
# Author: Ian Howell, Embodied Music Lab (www.embodiedmusiclab.com)
# Framework: EML PraatGen
# ============================================================================

# Capture Praat version for output (see notes section if output retained)
praatVer\$ = praatVersion\$

# --- Input: sustained vowel (sv) and continuous speech (cs) ---
svId = ${1:svSoundId}
csId = ${2:csSoundId}

# --- PART 1: High-pass filter (stop Hann band 0 to 34 Hz) ---
selectObject: csId
csFiltered = noprogress Filter (stop Hann band): 0, 34, 0.1
selectObject: svId
svFiltered = noprogress Filter (stop Hann band): 0, 34, 0.1

# --- PART 2: Voiced segment extraction from continuous speech ---

# Step 2a: Silence detection on filtered CS
selectObject: csFiltered
csGrid = noprogress To TextGrid (silences): 50, 0.003, -25, 0.1, 0.1, "silence", "sounding"

# Step 2b: Extract non-silence intervals and concatenate into onlyLoud
selectObject: csFiltered
plusObject: csGrid
Extract intervals where: 1, "no", "does not contain", "silence"
nLoudExtracted = numberOfSelected ("Sound")
loudIds# = zero# (nLoudExtracted)
for iLoud from 1 to nLoudExtracted
    loudIds#[iLoud] = selected ("Sound", iLoud)
endfor
onlyLoud = noprogress Concatenate
for iLoud from 1 to nLoudExtracted
    removeObject: loudIds#[iLoud]
endfor
removeObject: csGrid

# Step 2c: Initialize parameters and onlyVoice (1 ms silence prefix)
selectObject: onlyLoud
samplingRate = Get sampling frequency
intermediateSamples = Get sampling period
signalStart = Get start time
signalEnd = Get end time
globalPower = Get power in air
voicelessThreshold = globalPower * 0.3

onlyVoiceId = Create Sound from formula: "onlyVoice", 1, 0, 0.001, samplingRate, "0"

# Step 2d: Slide 30 ms non-overlapping windows through onlyLoud.
# Keep windows where power > 30% global power AND ZCR < 3000/s.
windowWidth = 0.03
windowBorderLeft = signalStart
windowBorderRight = windowBorderLeft + windowWidth
extremeRight = signalEnd - windowWidth

while windowBorderRight < extremeRight
    selectObject: onlyLoud
    windowSnd = Extract part: windowBorderLeft, windowBorderRight, "rectangular", 1, "no"
    selectObject: windowSnd
    partialPower = Get power in air
    if partialPower > voicelessThreshold
        @checkZeros: windowSnd, intermediateSamples
        if checkZeros.rate <> undefined and checkZeros.rate < 3000
            selectObject: onlyVoiceId
            plusObject: windowSnd
            newVoiceId = noprogress Concatenate
            removeObject: onlyVoiceId, windowSnd
            onlyVoiceId = newVoiceId
        else
            removeObject: windowSnd
        endif
    else
        removeObject: windowSnd
    endif
    windowBorderLeft = windowBorderLeft + windowWidth
    windowBorderRight = windowBorderLeft + windowWidth
endwhile

removeObject: onlyLoud
removeObject: csFiltered

# Capture voiced-CS duration for v.03.01 protocol compliance check
selectObject: onlyVoiceId
durationVCS = Get total duration

# --- PART 3: Sustained vowel — last 3 seconds if longer than 3 s ---
selectObject: svFiltered
svDur = Get total duration
if svDur > 3
    sv2 = Extract part: svDur - 3, svDur, "rectangular", 1, "no"
else
    sv2 = Copy: "sv2"
endif
removeObject: svFiltered

# --- PART 4: Concatenate onlyVoice + sv2 (canonical order) ---
selectObject: onlyVoiceId
plusObject: sv2
avqiSignal = noprogress Concatenate
removeObject: onlyVoiceId, sv2

# --- PART 5a: CPPS (Maryn et al., 2015) ---
selectObject: avqiSignal
cepstrogram = noprogress To PowerCepstrogram: 60, 0.002, 5000, 50
cpps = Get CPPS: "no", 0.01, 0.001, 60, 330, 0.05, "Parabolic", 0.001, 0, "Straight", "Robust"
removeObject: cepstrogram

# --- PART 5b: LTAS slope (whole spectrum, energy averaging) ---
selectObject: avqiSignal
ltas = noprogress To Ltas: 1
slope = Get slope: 0, 1000, 1000, 10000, "energy"

# --- PART 5c: LTAS tilt (regression trend line through 1 to 10000 Hz) ---
trendLine = noprogress Compute trend line: 1, 10000
tilt = Get slope: 0, 1000, 1000, 10000, "energy"
removeObject: trendLine, ltas

# --- PART 5d: Shimmer via PointProcess (periodic, cc) — direct from Sound ---
selectObject: avqiSignal
ppShim = noprogress To PointProcess (periodic, cc): 50, 400
selectObject: avqiSignal, ppShim
percentShimmer = Get shimmer (local): 0, 0, 0.0001, 0.02, 1.3, 1.6
shim = percentShimmer * 100
shdb = Get shimmer (local_dB): 0, 0, 0.0001, 0.02, 1.3, 1.6
removeObject: ppShim

# --- PART 5e: HNR via Voice report (uses its own Pitch object 75 to 600) ---
selectObject: avqiSignal
pitchHnr = noprogress To Pitch (raw cross-correlation): 0, 75, 600, 15, "no", 0.03, 0.45, 0.01, 0.35, 0.14
selectObject: avqiSignal, pitchHnr
ppHnr = noprogress To PointProcess (cc)
selectObject: avqiSignal, pitchHnr, ppHnr
voiceReport\$ = noprogress Voice report: 0, 0, 75, 600, 1.3, 1.6, 0.03, 0.45
hnr = extractNumber (voiceReport\$, "Mean harmonics-to-noise ratio: ")
removeObject: pitchHnr, ppHnr

# --- PART 6: AVQI regression — BOTH versions ---
# v.02.06 (Maryn & Weenink, 2015, J Voice 29:35-43)
avqi = ((3.295 - (0.111 * cpps) - (0.073 * hnr) - (0.213 * shim) + (2.789 * shdb) - (0.032 * slope) + (0.077 * tilt)) * 2.208) + 1.797

# v.03.01 (Barsties & Maryn, 2015, Am J Otolaryngol 36:647-656, Section 3.3)
# Same predictors, different regression weights. Protocol assumption: input
# CS was syllable-controlled to produce ~3 s of voiced material after
# extraction (matching the 3 s SV). Note SIGN FLIP on Slope coefficient
# vs v.02.06 (-0.032 to +0.01).
avqiV3 = (4.152 - (0.177 * cpps) - (0.006 * hnr) - (0.037 * shim) + (0.941 * shdb) + (0.01 * slope) + (0.093 * tilt)) * 2.8902

# v.03.01 protocol compliance check (vCS should be ~3 s for valid v.03.01)
vCSDurationOK = (durationVCS >= 2.5 and durationVCS <= 3.5)

# Light extrapolation flag: flags clearly out-of-distribution predictors
# (e.g., synthesized clean signals). Bounds are loose clinical-range
# estimates, not training-distribution bounds.
extrapolationFlag = 0
if cpps < 4 or cpps > 22
    extrapolationFlag = extrapolationFlag + 1
endif
if hnr < 0 or hnr > 30
    extrapolationFlag = extrapolationFlag + 1
endif
if shim < 0.1 or shim > 20
    extrapolationFlag = extrapolationFlag + 1
endif
if shdb < 0.05 or shdb > 3
    extrapolationFlag = extrapolationFlag + 1
endif

# ============================================================================
# OUTPUT SECTION — modify or delete for your calling script
# ============================================================================
# The block below writes to the Info window. If your calling script handles
# output differently (writes to a Table, returns variables, appends to a
# CSV, etc.), DELETE or COMMENT OUT the lines from writeInfoLine through
# the final appendInfoLine. Available variables for your own output:
#
#   avqi        — AVQI v.02.06 score
#   avqiV3      — AVQI v.03.01 score
#   cpps, hnr, shim, shdb, slope, tilt — predictors
#   durationVCS — voiced CS duration (s); ~3.0 = v.03.01 protocol compliant
#   vCSDurationOK — boolean (1 if 2.5-3.5 s, 0 otherwise)
#   extrapolationFlag — count of predictors outside clinical bounds
#   praatVer\$   — Praat version string (affects CPPS algorithm vintage)
# ============================================================================

writeInfoLine: "AVQI Results"
appendInfoLine: "Praat version: ", praatVer\$
appendInfoLine: ""
appendInfoLine: "vCS duration: ", fixed\$(durationVCS, 3), " s"
if not vCSDurationOK
    appendInfoLine: "  WARNING: outside 2.5-3.5 s expected by v.03.01 protocol."
    appendInfoLine: "  Use syllable-controlled CS: Dutch=34, Italian=25, German/French=27,"
    appendInfoLine: "  Japanese=30, Spanish=33, Korean=26, BR Portuguese=17 syllables."
endif
appendInfoLine: ""
appendInfoLine: "Predictors:"
appendInfoLine: "  CPPS:        ", fixed\$(cpps, 3), " dB"
appendInfoLine: "  HNR:         ", fixed\$(hnr, 2), " dB"
appendInfoLine: "  Shimmer %:   ", fixed\$(shim, 2)
appendInfoLine: "  Shimmer dB:  ", fixed\$(shdb, 3), " dB"
appendInfoLine: "  LTAS slope:  ", fixed\$(slope, 3), " dB"
appendInfoLine: "  LTAS tilt:   ", fixed\$(tilt, 3), " dB"
if extrapolationFlag > 0
    appendInfoLine: "  (", extrapolationFlag, " predictor(s) outside typical clinical range — scores may extrapolate)"
endif
appendInfoLine: ""
appendInfoLine: "AVQI v.02.06: ", fixed\$(avqi, 3)
appendInfoLine: "AVQI v.03.01: ", fixed\$(avqiV3, 3)
appendInfoLine: ""
appendInfoLine: "Note: CPPS algorithm differs across Praat versions (changes at"
appendInfoLine: "6.1.37, 6.4.39, 6.4.58). VOXplot pins Praat 6.0.48. AVQI scores"
appendInfoLine: "computed in different Praat versions are NOT directly comparable."

# Cleanup
removeObject: avqiSignal

# ============================================================================
# Procedure: checkZeros
#
# Counts zero crossings within the middle 25 ms of a 30 ms window
# (from 0.0025 s to 0.0275 s). The rate is normalised by the actual
# measured distance between the first and last zero crossings in the
# analysis range, not the nominal 25 ms — this replicates the canonical
# Phonanium algorithm.
#
# Returns:
#   .rate — zero crossings per second, or undefined if fewer than two
#           crossings were found in the analysis range
# ============================================================================
procedure checkZeros: .sndId, .intermediateSamples
    selectObject: .sndId
    .start = 0.0025
    .startZero = Get nearest zero crossing: 1, .start
    .findStart = .startZero
    .findNext = .startZero + .intermediateSamples
    .nextZero = Get nearest zero crossing: 1, .findNext
    .nCrossings = 0
    .afstand = undefined
    while .findStart < 0.0275 and .findStart <> undefined
        while .nextZero = .findStart
            .findNext = .findNext + .intermediateSamples
            .nextZero = Get nearest zero crossing: 1, .findNext
        endwhile
        .afstand = .nextZero - .startZero
        .nCrossings = .nCrossings + 1
        .findStart = .nextZero
    endwhile
    if .afstand <> undefined and .afstand > 0
        .rate = .nCrossings / .afstand
    else
        .rate = undefined
    endif
endproc

${0}]]></content>
    <tabTrigger>avqi</tabTrigger>
    <scope>source.praat</scope>
    <description>AVQI v.02.06 + v.03.01 parallel analysis — independent implementation (Maryn & Weenink 2015; Barsties & Maryn 2015)</description>
