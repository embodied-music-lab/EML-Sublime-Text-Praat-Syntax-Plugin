<snippet>
    <content><![CDATA[# ============================================================================
# AVQI v.02.06 + v.03.01 Analysis
# ============================================================================
# Purpose: Compute the Acoustic Voice Quality Index v.02.06 (Maryn &
# Weenink, 2015) and optionally v.03.01 (Barsties & Maryn, 2015) on a
# paired sustained vowel + continuous speech recording.
#
# Algorithm: Voiced-segment extraction follows the canonical Phonanium
# AVQI v.02.06 procedure — high-pass filter (stop Hann 0 to 34 Hz),
# silence-based segmentation (To TextGrid (silences) at -25 dB), 30 ms
# non-overlapping windows classified voiced via power > 30% of global
# power AND zero-crossing rate < 3000/s. When v.03.01 is enabled, a
# second avqi signal is constructed from the first 3 s of voiced
# continuous speech concatenated with the same sustained-vowel
# selection, and all six predictors are recomputed on that signal
# before the v.03.01 regression is applied.
#
# Sustained vowel selection modes:
#   entire     — use the full sustained vowel (irrespective of duration)
#   middle 3 s — center cut (Maryn & Roy 2009 original methodology)
#   final 3 s  — last 3 s (current Phonanium canonical; default)
#
# See GROUNDED_ARGUMENTS_AVQI_v0.8-beta.12.md for methodological
# rationale on truncation direction, dual signals, sustained vowel
# mode default, and the fixed\$ rounding fix.
#
# Date: 24 May 2026
# Version: 3.2
#
# ATTRIBUTION
# Framework: EML PraatGen by Ian Howell
#            Embodied Music Lab — www.embodiedmusiclab.com
#            https://github.com/embodied-music-lab/PraatGen
# Code generation: Claude (Anthropic)
# Script author: Ian Howell — created and verified by this individual
#
# RESEARCH USE DISCLOSURE
# If used in research or publication, disclose AI use per your target
# journal's policy. Suggested language:
#
#   "AVQI v.02.06 (Maryn & Weenink, 2015) and v.03.01 (Barsties & Maryn,
#    2015) were computed using an EML PraatGen-generated Praat script
#    (Howell, Embodied Music Lab; code generation by Claude/Anthropic).
#    Voiced-segment extraction follows the canonical Phonanium v.02.06
#    algorithm. The v.03.01 score was computed on a separate avqi signal
#    constructed from the first 3 s of voiced continuous speech plus the
#    [final/middle/entire] portion of the sustained vowel. All output
#    was reviewed and validated by [your name]."
#
# License: GPL-3.0-or-later
# ============================================================================

# ============================================================================
# SETTINGS DIALOG (commentable-out)
# ============================================================================
# To bypass this dialog (e.g., when calling from another script),
# comment out the beginPause/endPause block and the variable
# assignments below it. Set these variables manually instead:
#
#   svFile\$           — path to sustained vowel WAV (only if useSelected = 0)
#   csFile\$           — path to continuous speech WAV (only if useSelected = 0)
#   useSelected       — 0: read from files
#                       1: use the Sound objects named "sv" and "cs"
#                          that are SELECTED (highlighted) in the
#                          Objects window
#   svMode\$           — "entire" | "middle 3 s" | "final 3 s"
#   runV3             — 0: v.02.06 only | 1: also compute v.03.01
#   outputDir\$        — folder for results text file ("" = skip)
#   outputFilename\$   — filename within outputDir\$
#                       (e.g., "avqi_results.txt")
#
# The input-validation loops below will still run; they re-show a
# small dialog if the requested files or objects are missing. For
# fully unattended operation, also comment out the validation loops
# and set svId / csId directly.
# ============================================================================

beginPause: "AVQI analysis settings"
comment: "=========================================================="
comment: "AVQI ANALYSIS: From a sustained vowel and continuous speech recording"
comment: "=========================================================="
    choice: "Input source", 1
        option: "Read sv and cs from WAV files"
        option: "sv and cs Sound objects selected"
 
    comment: "If reading from files, browse to them here"
    infile: "Sustained vowel file", ""
    infile: "Continuous speech file", ""
    optionmenu: "Sustained vowel mode (if longer than 3 s)", 3
        option: "entire"
        option: "middle 3 s"
        option: "final 3 s"
    comment: "----------------------------------------------------------"
    boolean: "Also compute v 03 01", 1
    comment: "NOTE: v.03.01 expects ~3 s of voiced continuous speech;"
    comment: "If enabled, voiced continuous speech is truncated to its first 3 s;"
    comment: "v.02.06 always uses the full voiced continuous speech."
    comment: "----------------------------------------------------------"
    comment: "Results print to Info Window. To save to a text file choose output folder:"
    folder: "Output folder", ""
    sentence: "Output filename", "avqi_results.txt"

clicked = endPause: "Quit", "Run", 2, 0
if clicked = 1
    exitScript: "User cancelled."
endif

svFile\$         = sustained_vowel_file\$
csFile\$         = continuous_speech_file\$
useSelected     = (input_source = 2)
svMode\$         = sustained_vowel_mode\$
runV3           = also_compute_v_03_01
outputDir\$      = output_folder\$
outputFilename\$ = output_filename\$

# ============================================================================
# RESOLVE INPUT OBJECTS — popups (Continue/Quit) on failure
# ============================================================================

if useSelected
    selValid = 0
    while not selValid
        svId = 0
        csId = 0
        nSel = numberOfSelected ("Sound")
        for iSel from 1 to nSel
            selName\$ = selected\$ ("Sound", iSel)
            if selName\$ = "sv"
                svId = selected ("Sound", iSel)
            elsif selName\$ = "cs"
                csId = selected ("Sound", iSel)
            endif
        endfor
        if svId > 0 and csId > 0
            selValid = 1
        else
            if svId = 0 and csId = 0
                problem\$ = "No Sound named sv or cs is currently selected."
            elsif svId = 0
                problem\$ = "No Sound named sv is currently selected."
            else
                problem\$ = "No Sound named cs is currently selected."
            endif
            beginPause: "Selection issue"
                comment: problem\$
                comment: ""
                comment: "Select both Sound sv and Sound cs in the Objects window,"
                comment: "then click Continue. Or Quit to abort."
            clicked = endPause: "Quit", "Continue", 2, 0
            if clicked = 1
                exitScript: "User aborted."
            endif
        endif
    endwhile
else
    pathValid = 0
    while not pathValid
        svOk = fileReadable (svFile\$)
        csOk = fileReadable (csFile\$)
        if svOk and csOk
            pathValid = 1
        else
            if not svOk and not csOk
                problem\$ = "Neither file is readable."
            elsif not svOk
                problem\$ = "Sustained vowel file is not readable: " + svFile\$
            else
                problem\$ = "Continuous speech file is not readable: " + csFile\$
            endif
            beginPause: "File issue"
                comment: problem\$
                comment: ""
                infile: "Sustained vowel file", svFile\$
                infile: "Continuous speech file", csFile\$
            clicked = endPause: "Quit", "Continue", 2, 0
            if clicked = 1
                exitScript: "User aborted."
            endif
            svFile\$ = sustained_vowel_file\$
            csFile\$ = continuous_speech_file\$
        endif
    endwhile
    svId = Read from file: svFile\$
    Rename: "sv"
    csId = Read from file: csFile\$
    Rename: "cs"
endif

# ============================================================================
# RESOLVE OUTPUT FILE PATH — Rule 27 overwrite protection
# ============================================================================
# If outputDir\$ is non-blank, construct outputDir\$ + "/" + outputFilename\$
# and apply Rule 27 overwrite protection. Existing files get an
# auto-numbered suffix (_2, _3, ...). If outputDir\$ is blank, file
# output is skipped entirely.

finalOutputFile\$ = ""
if outputDir\$ <> ""
    # Strip trailing slash for clean concatenation
    if right\$ (outputDir\$, 1) = "/"
        outputDir\$ = left\$ (outputDir\$, length (outputDir\$) - 1)
    endif
    candidatePath\$ = outputDir\$ + "/" + outputFilename\$
    @resolveOutputPath: candidatePath\$
    finalOutputFile\$ = resolveOutputPath.path\$
endif

# Capture Praat version for the output (CPPS algorithm vintage)
praatVer\$ = praatVersion\$

# ============================================================================
# PART 1 — High-pass filter (canonical Phonanium, applied to both)
# ============================================================================

selectObject: svId
svFiltered = noprogress Filter (stop Hann band): 0, 34, 0.1

selectObject: csId
csFiltered = noprogress Filter (stop Hann band): 0, 34, 0.1

# ============================================================================
# PART 2 — Voiced-segment extraction from filtered continuous speech
# ============================================================================
# Canonical Phonanium algorithm: silence detection -> 30 ms non-overlap
# window slide -> keep windows where power > 30% global power AND
# zero-crossing rate < 3000/s.

selectObject: csFiltered
csGrid = noprogress To TextGrid (silences): 50, 0.003, -25, 0.1, 0.1, "silence", "sounding"

selectObject: csFiltered
plusObject: csGrid
Extract intervals where: 1, "no", "does not contain", "silence"
nLoudExtracted = numberOfSelected ("Sound")
loudIds# = zero# (nLoudExtracted)
for iLoud from 1 to nLoudExtracted
    loudIds# [iLoud] = selected ("Sound", iLoud)
endfor
onlyLoud = noprogress Concatenate
for iLoud from 1 to nLoudExtracted
    removeObject: loudIds# [iLoud]
endfor
removeObject: csGrid

selectObject: onlyLoud
samplingRate = Get sampling frequency
intermediateSamples = Get sampling period
signalStart = Get start time
signalEnd = Get end time
globalPower = Get power in air
voicelessThreshold = globalPower * 0.3

# Start onlyVoice as a 1 ms silence prefix (canonical Phonanium starter)
onlyVoiceId = Create Sound from formula: "onlyVoice", 1, 0, 0.001, samplingRate, "0"

windowWidth = 0.03
windowBorderLeft = signalStart
windowBorderRight = windowBorderLeft + windowWidth
extremeRight = signalEnd - windowWidth

while windowBorderRight < extremeRight
    selectObject: onlyLoud
    windowSnd = Extract part: windowBorderLeft, windowBorderRight, "rectangular", 1, "no"
    selectObject: windowSnd
    partialPower = Get power in air
    if partialPower > voicelessThreshold
        @checkZeros: windowSnd, intermediateSamples
        if checkZeros.rate <> undefined and checkZeros.rate < 3000
            selectObject: onlyVoiceId
            plusObject: windowSnd
            newVoiceId = noprogress Concatenate
            removeObject: onlyVoiceId, windowSnd
            onlyVoiceId = newVoiceId
        else
            removeObject: windowSnd
        endif
    else
        removeObject: windowSnd
    endif
    windowBorderLeft = windowBorderLeft + windowWidth
    windowBorderRight = windowBorderLeft + windowWidth
endwhile

removeObject: onlyLoud
removeObject: csFiltered

selectObject: onlyVoiceId
durationVoicedCS = Get total duration

# ============================================================================
# PART 3 — Sustained vowel selection (svMode\$)
# ============================================================================
# Always operates on the filtered sustained vowel. If duration <= 3 s,
# all modes degenerate to "entire."

selectObject: svFiltered
svDur = Get total duration

if svMode\$ = "entire" or svDur <= 3
    svPart = Copy: "svPart"
elsif svMode\$ = "middle 3 s"
    svMidStart = (svDur - 3) / 2
    svPart = Extract part: svMidStart, svMidStart + 3, "rectangular", 1, "no"
else
    # "final 3 s"
    svPart = Extract part: svDur - 3, svDur, "rectangular", 1, "no"
endif

removeObject: svFiltered

selectObject: svPart
durationSV = Get total duration

# ============================================================================
# PART 4 — Build v.02.06 avqi signal (full voiced CS + sustained vowel part)
# ============================================================================

selectObject: onlyVoiceId
plusObject: svPart
avqiV2signal = noprogress Concatenate
Rename: "avqi_v0206"

# ============================================================================
# PART 5 — Run predictor pipeline on v.02.06 avqi signal
# ============================================================================

@runAvqiPipeline: avqiV2signal
cpps  = runAvqiPipeline.cpps
hnr   = runAvqiPipeline.hnr
shim  = runAvqiPipeline.shim
shdb  = runAvqiPipeline.shdb
slope = runAvqiPipeline.slope
tilt  = runAvqiPipeline.tilt

# AVQI v.02.06 regression (Maryn & Weenink, 2015, J Voice 29(1):35-43,
# DOI: 10.1016/j.jvoice.2014.06.015)
avqi = ((3.295 - (0.111 * cpps) - (0.073 * hnr) - (0.213 * shim) + (2.789 * shdb) - (0.032 * slope) + (0.077 * tilt)) * 2.208) + 1.797

# ============================================================================
# PART 6 — v.03.01 path (separate avqi signal, separate predictors)
# ============================================================================
# Build only if requested AND voiced continuous speech >= 3 s. Truncates
# voiced continuous speech to its first 3 s (preserves prosodic onset;
# models a protocol-compliant syllable-controlled recording).

v3Computable = (runV3 and durationVoicedCS >= 3)

if v3Computable
    selectObject: onlyVoiceId
    onlyVoiceTrunc = Extract part: 0, 3, "rectangular", 1, "no"

    selectObject: onlyVoiceTrunc
    plusObject: svPart
    avqiV3signal = noprogress Concatenate
    Rename: "avqi_v0301"

    removeObject: onlyVoiceTrunc

    @runAvqiPipeline: avqiV3signal
    cppsV3  = runAvqiPipeline.cpps
    hnrV3   = runAvqiPipeline.hnr
    shimV3  = runAvqiPipeline.shim
    shdbV3  = runAvqiPipeline.shdb
    slopeV3 = runAvqiPipeline.slope
    tiltV3  = runAvqiPipeline.tilt

    # AVQI v.03.01 regression (Barsties & Maryn, 2015, Am J Otolaryngol 36(5):647-656,
    # DOI: 10.1016/j.amjoto.2015.04.012)
    avqiV3 = (4.152 - (0.177 * cppsV3) - (0.006 * hnrV3) - (0.037 * shimV3) + (0.941 * shdbV3) + (0.01 * slopeV3) + (0.093 * tiltV3)) * 2.8902

    removeObject: avqiV3signal
endif

# ============================================================================
# PART 7 — Cleanup intermediate signals
# ============================================================================

removeObject: onlyVoiceId, svPart, avqiV2signal

# ============================================================================
# PART 8 — Pre-format all numeric outputs (with rounding fix)
# ============================================================================

@roundFixed: cpps, 3
cppsOut\$ = roundFixed.result\$
@roundFixed: hnr, 2
hnrOut\$ = roundFixed.result\$
@roundFixed: shim, 2
shimOut\$ = roundFixed.result\$
@roundFixed: shdb, 3
shdbOut\$ = roundFixed.result\$
@roundFixed: slope, 3
slopeOut\$ = roundFixed.result\$
@roundFixed: tilt, 3
tiltOut\$ = roundFixed.result\$
@roundFixed: avqi, 2
avqiOut\$ = roundFixed.result\$
@roundFixed: durationSV, 3
durationSVOut\$ = roundFixed.result\$
@roundFixed: durationVoicedCS, 3
durationVoicedCSOut\$ = roundFixed.result\$

if v3Computable
    @roundFixed: cppsV3, 3
    cppsV3Out\$ = roundFixed.result\$
    @roundFixed: hnrV3, 2
    hnrV3Out\$ = roundFixed.result\$
    @roundFixed: shimV3, 2
    shimV3Out\$ = roundFixed.result\$
    @roundFixed: shdbV3, 3
    shdbV3Out\$ = roundFixed.result\$
    @roundFixed: slopeV3, 3
    slopeV3Out\$ = roundFixed.result\$
    @roundFixed: tiltV3, 3
    tiltV3Out\$ = roundFixed.result\$
    @roundFixed: avqiV3, 2
    avqiV3Out\$ = roundFixed.result\$
endif

# ============================================================================
# PART 9 — Output (Info window + optional file mirror)
# ============================================================================

writeInfoLine: ""
if finalOutputFile\$ <> ""
    writeFile: finalOutputFile\$, ""
endif

@out: "========================================================================"
@out: "                          AVQI ANALYSIS"
@out: "========================================================================"
@out: ""
@out: "  AVQI v.02.06:  " + avqiOut\$
if v3Computable
    @out: "  AVQI v.03.01:  " + avqiV3Out\$
elsif runV3
    @out: "  AVQI v.03.01:  not computable (voiced continuous speech < 3 s)"
endif
@out: ""
@out: "------------------------------------------------------------------------"
@out: "  Analysis details"
@out: "------------------------------------------------------------------------"
@out: ""
@out: "  Praat version:               " + praatVer\$
@out: "  Sustained vowel mode:        " + svMode\$
@out: "  Sustained vowel used:        " + durationSVOut\$ + " s"
@out: "  Voiced continuous speech:    " + durationVoicedCSOut\$ + " s"
@out: ""
@out: "------------------------------------------------------------------------"
@out: "  v.02.06 predictors  (full voiced continuous speech)"
@out: "------------------------------------------------------------------------"
@out: ""
@out: "  CPPS         " + cppsOut\$ + " dB"
@out: "  HNR          " + hnrOut\$ + " dB"
@out: "  Shimmer %    " + shimOut\$
@out: "  Shimmer dB   " + shdbOut\$ + " dB"
@out: "  LTAS slope   " + slopeOut\$ + " dB"
@out: "  LTAS tilt    " + tiltOut\$ + " dB"

if v3Computable
    @out: ""
    @out: "------------------------------------------------------------------------"
    @out: "  v.03.01 predictors  (first 3 s of voiced continuous speech)"
    @out: "------------------------------------------------------------------------"
    @out: ""
    @out: "  CPPS         " + cppsV3Out\$ + " dB"
    @out: "  HNR          " + hnrV3Out\$ + " dB"
    @out: "  Shimmer %    " + shimV3Out\$
    @out: "  Shimmer dB   " + shdbV3Out\$ + " dB"
    @out: "  LTAS slope   " + slopeV3Out\$ + " dB"
    @out: "  LTAS tilt    " + tiltV3Out\$ + " dB"
endif

@out: ""
# --- Optional: Praat version caveat (safe to delete) ---
@out: "------------------------------------------------------------------------"
@out: "  Praat version note"
@out: "------------------------------------------------------------------------"
@out: ""
@out: "  CPPS algorithm changes across Praat versions (6.1.37, 6.4.39,"
@out: "  6.4.58). AVQI scores from different Praat versions are NOT"
@out: "  directly comparable. Report the Praat version alongside every"
@out: "  AVQI score."
@out: ""
# --- Optional: References block (safe to delete) ---
@out: "------------------------------------------------------------------------"
@out: "  Where to find population-specific cutoffs"
@out: "------------------------------------------------------------------------"
@out: ""
@out: "  AVQI clinical thresholds vary by language, population, recording"
@out: "  protocol, and Praat version. This script does not endorse a"
@out: "  threshold. Consult the validation literature for your population:"
@out: ""
@out: "  Methodology and regression equations:"
@out: "    Maryn, Y., & Weenink, D. (2015). Objective dysphonia measures"
@out: "      in the program Praat: smoothed cepstral peak prominence and"
@out: "      acoustic voice quality index. Journal of Voice, 29(1), 35-43."
@out: "      https://doi.org/10.1016/j.jvoice.2014.06.015"
@out: "    Barsties, B., & Maryn, Y. (2015). The improvement of internal"
@out: "      consistency of the Acoustic Voice Quality Index. American"
@out: "      Journal of Otolaryngology, 36(5), 647-656."
@out: "      https://doi.org/10.1016/j.amjoto.2015.04.012"
@out: ""
@out: "  Cross-language threshold comparison:"
@out: "    Maryn, Y., De Bodt, M., Barsties, B., & Roy, N. (2014). The"
@out: "      value of the acoustic voice quality index as a measure of"
@out: "      dysphonia severity in subjects speaking different languages."
@out: "      European Archives of Oto-Rhino-Laryngology, 271(6), 1609-1619."
@out: "      https://doi.org/10.1007/s00405-013-2730-7"
@out: ""
@out: "  Meta-analysis with cross-language threshold ranges:"
@out: "    Jayakumar, T., & Benoy, J. J. (2024). Acoustic Voice Quality"
@out: "      Index (AVQI) in the Measurement of Voice Quality: A Systematic"
@out: "      Review and Meta-Analysis. Journal of Voice, 38(5), 1055-1069."
@out: "      v.02 range 2.72-3.33 (7 studies); v.03 range 1.33-3.15 (8 studies)."
@out: "      https://doi.org/10.1016/j.jvoice.2022.03.018"
@out: ""
@out: "  Representative recent single-language validation:"
@out: "    Fantini, M., Ricci Maccarini, A., Firino, A., et al. (2023)."
@out: "      Validation of the Acoustic Voice Quality Index (AVQI) Version"
@out: "      03.01 in Italian. Journal of Voice, 37(4), 631.e1-631.e6."
@out: "      https://doi.org/10.1016/j.jvoice.2021.02.029"
@out: ""
@out: "========================================================================"

# Footer: report file output status (Info window only — not mirrored)
if finalOutputFile\$ <> ""
    appendInfoLine: ""
    appendInfoLine: "Results saved to: ", finalOutputFile\$
    if finalOutputFile\$ <> candidatePath\$
        appendInfoLine: "  (requested path existed; saved with auto-numbered suffix)"
    endif
endif

# ============================================================================
# PROCEDURES
# ============================================================================

# ----------------------------------------------------------------------------
# @out: line\$
# ----------------------------------------------------------------------------
# Writes a line to the Info window, and also to finalOutputFile\$ if
# the user supplied an output path.
# ----------------------------------------------------------------------------
procedure out: .line\$
    appendInfoLine: .line\$
    if finalOutputFile\$ <> ""
        appendFileLine: finalOutputFile\$, .line\$
    endif
endproc

# ----------------------------------------------------------------------------
# @resolveOutputPath: candidate\$
# ----------------------------------------------------------------------------
# Rule 27 overwrite protection. If the candidate path already exists,
# append an ascending integer suffix (_2, _3, ...) to the basename
# until a non-existing path is found. Handles paths with or without
# a file extension.
# Returns: .path\$ — the resolved (free) path to write to.
# ----------------------------------------------------------------------------
procedure resolveOutputPath: .candidate\$
    .path\$ = .candidate\$
    if fileReadable (.path\$)
        .baseName\$ = .candidate\$
        .extension\$ = ""
        .dotPos = rindex (.candidate\$, ".")
        if .dotPos > 0
            .baseName\$ = left\$ (.candidate\$, .dotPos - 1)
            .extension\$ = mid\$ (.candidate\$, .dotPos, length (.candidate\$) - .dotPos + 1)
        endif
        .suffix = 2
        repeat
            .path\$ = .baseName\$ + "_" + string\$ (.suffix) + .extension\$
            .suffix = .suffix + 1
        until not fileReadable (.path\$)
    endif
endproc

# ----------------------------------------------------------------------------
# @roundFixed: value, decimals
# ----------------------------------------------------------------------------
# Returns .result\$ = the value rounded to the specified number of
# decimals, formatted via fixed\$. Compensates for IEEE 754 binary
# representation errors that cause fixed\$ alone to round computed
# values downward at decimal half-boundaries.
# ----------------------------------------------------------------------------
procedure roundFixed: .value, .decimals
    .multiplier = 10 ^ .decimals
    .result\$ = fixed\$ (round (.value * .multiplier) / .multiplier, .decimals)
endproc

# ----------------------------------------------------------------------------
# @runAvqiPipeline: avqiId
# ----------------------------------------------------------------------------
# Computes the six AVQI predictors on a concatenated avqi Sound.
# Returns .cpps, .hnr, .shim, .shdb, .slope, .tilt.
#
# Parameters are canonical Phonanium AVQI v.02.06 (APPENDIX_D §10).
# HNR uses a dedicated Pitch object with 75 to 600 Hz range, NOT the
# 50 to 400 Hz Pitch used internally by the shimmer step — matching
# the canonical Phonanium script.
# ----------------------------------------------------------------------------
procedure runAvqiPipeline: .avqiId
    # CPPS
    selectObject: .avqiId
    .cepstrogram = noprogress To PowerCepstrogram: 60, 0.002, 5000, 50
    .cpps = Get CPPS: "no", 0.01, 0.001, 60, 330, 0.05, "Parabolic", 0.001, 0, "Straight", "Robust"
    removeObject: .cepstrogram

    # LTAS slope and tilt
    selectObject: .avqiId
    .ltas = noprogress To Ltas: 1
    .slope = Get slope: 0, 1000, 1000, 10000, "energy"
    .trendLine = noprogress Compute trend line: 1, 10000
    .tilt = Get slope: 0, 1000, 1000, 10000, "energy"
    removeObject: .trendLine, .ltas

    # Shimmer (local and local_dB) via PointProcess (periodic, cc) direct from Sound
    selectObject: .avqiId
    .ppShim = noprogress To PointProcess (periodic, cc): 50, 400
    selectObject: .avqiId, .ppShim
    .percentShimmer = Get shimmer (local): 0, 0, 0.0001, 0.02, 1.3, 1.6
    .shim = .percentShimmer * 100
    .shdb = Get shimmer (local_dB): 0, 0, 0.0001, 0.02, 1.3, 1.6
    removeObject: .ppShim

    # HNR via Voice report with its own 75 to 600 Hz Pitch (canonical Phonanium)
    selectObject: .avqiId
    .pitchHnr = noprogress To Pitch (raw cross-correlation): 0, 75, 600, 15, "no", 0.03, 0.45, 0.01, 0.35, 0.14
    selectObject: .avqiId, .pitchHnr
    .ppHnr = noprogress To PointProcess (cc)
    selectObject: .avqiId, .pitchHnr, .ppHnr
    .voiceReport\$ = noprogress Voice report: 0, 0, 75, 600, 1.3, 1.6, 0.03, 0.45
    .hnr = extractNumber (.voiceReport\$, "Mean harmonics-to-noise ratio: ")
    removeObject: .pitchHnr, .ppHnr
endproc

# ----------------------------------------------------------------------------
# @checkZeros: sndId, intermediateSamples
# ----------------------------------------------------------------------------
# Counts zero crossings within the middle 25 ms of a 30 ms window
# (from 0.0025 s to 0.0275 s) and computes the rate in crossings per
# second, normalised by the measured distance between first and last
# crossings (not the nominal 25 ms). Replicates the canonical
# Phonanium algorithm.
#
# Returns .rate (undefined if fewer than two crossings).
# ----------------------------------------------------------------------------
procedure checkZeros: .sndId, .intermediateSamples
    selectObject: .sndId
    .start = 0.0025
    .startZero = Get nearest zero crossing: 1, .start
    .findStart = .startZero
    .findNext = .startZero + .intermediateSamples
    .nextZero = Get nearest zero crossing: 1, .findNext
    .nCrossings = 0
    .afstand = undefined
    while .findStart < 0.0275 and .findStart <> undefined
        while .nextZero = .findStart
            .findNext = .findNext + .intermediateSamples
            .nextZero = Get nearest zero crossing: 1, .findNext
        endwhile
        .afstand = .nextZero - .startZero
        .nCrossings = .nCrossings + 1
        .findStart = .nextZero
    endwhile
    if .afstand <> undefined and .afstand > 0
        .rate = .nCrossings / .afstand
    else
        .rate = undefined
    endif
endproc
